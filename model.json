{
  "kind": "slack",
  "version": "0.1.0",
  "title": "Slack",
  "description": "Post, update and read Slack messages with a bot token.",
  "repository_url": "https://github.com/HackInvent/bloxmith-slack",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, a Slack app bot token (xoxb-) with the needed scopes stored in the BloxSmith wallet, the bot invited to each allowlisted conversation, and outbound HTTPS access to slack.com and files.slack.com."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "message",
        "title": "message",
        "accepts": [
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "file",
        "title": "file",
        "accepts": [
          "file/path",
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "messages",
        "title": "messages",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "sent",
        "title": "sent",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "secret_ref": "",
    "allowed_channels": [],
    "default_channel": "",
    "file_root": "",
    "timeout_sec": 30,
    "page_size": 100,
    "max_pages": 5,
    "max_messages": 200,
    "max_file_bytes": 10485760,
    "max_response_bytes": 2097152,
    "max_retries": 2,
    "max_retry_wait_sec": 30,
    "api_base_url": "https://slack.com",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
